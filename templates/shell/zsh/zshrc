    _client_ip=$(echo "$SSH_CONNECTION" | awk '{print $1}')
    _server_ip=$(echo "$SSH_CONNECTION" | awk '{print $3}')
    if [[ $_server_ip == 100.* ]]; then
        export DOTS_SSH_ROUTE="Tailscale"
    elif [[ $_server_ip == 10.10.10.* ]]; then
        export DOTS_SSH_ROUTE="TB"
    else
        export DOTS_SSH_ROUTE="SSH"
    fi
    typeset -g DOTS_SSH_BANNER="─── SSH: $_client_ip → $_server_ip ($DOTS_SSH_ROUTE) ───"
    unset _client_ip _server_ip
fi

