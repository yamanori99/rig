# 起動バナーの幅は、中身の最長行に合わせる (ANSI は幅に数えない)
_dots_visible_len() {
  # EXTENDED_GLOB の # が「直前の 0 回以上」。glob の * だと行全体を食う
  setopt localoptions extendedglob
  local s="$1"
  s=${s//$'\033'\[[0-9;]#[A-Za-z]/}
  s=${s//$'\r'/}
  print -r -- ${#s}
}

_dots_max_width() {
  local line w=0 n
  for line in "${(@f)1}"; do
    n=$(_dots_visible_len "$line")
    (( n > w )) && w=$n
  done
  print -r -- $w
}

_dots_hrule() {
  local n=${1:-${DOTS_BANNER_WIDTH:-40}}
  (( n < 1 )) && n=1
  print -- "${(l:n::─:)}"
}

# 本文を枠で囲む。幅は最長行 (SSH 行があればそれも)
_dots_frame() {
  local body="$1"
  local w tw
  w=$(_dots_max_width "$body")
  if [[ -n ${DOTS_SSH_BANNER:-} ]]; then
    tw=$(_dots_visible_len "$DOTS_SSH_BANNER")
    (( tw > w )) && w=$tw
  fi
  (( w < 8 )) && w=8
  typeset -g DOTS_BANNER_WIDTH=$w
  if [[ -n ${DOTS_SSH_BANNER:-} ]]; then
    echo "\033[36m${(r:w::─:)DOTS_SSH_BANNER}\033[0m"
  else
    _dots_hrule $w
  fi
  print -r -- "$body"
  _dots_hrule $w
}

# --- SSH 接続時: 本文は後で fastfetch 枠の上辺にする ---
