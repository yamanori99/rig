# 長時間コマンド通知 (60秒以上で通知)
notify_on_complete() {
  local last_status=$?
  local last_cmd=$(fc -ln -1)
  local duration=$SECONDS
  # Remote SSH sessions do not have local NotificationCenter access.
  if [[ -n "$SSH_CONNECTION" ]]; then
    return
  fi

  if [[ $duration -ge 60 ]]; then
    if command -v terminal-notifier >/dev/null 2>&1; then
      terminal-notifier \
        -title "Command Complete" \
        -subtitle "Took ${duration}s (exit: $last_status)" \
        -message "$last_cmd" >/dev/null 2>&1 || true
    else
      osascript -e "display notification \"$last_cmd\" with title \"Command Complete\" subtitle \"Took ${duration}s (exit: $last_status)\"" >/dev/null 2>&1 || true
    fi
  fi
}
