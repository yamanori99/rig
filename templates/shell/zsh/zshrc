# Product zshrc — sourced only when ~/.config/rig/shell/use-product-rc exists.
# Not Oh My Zsh / p10k. Put personal thick config in overlay/shell/ instead.

if [ -n "${RIG_CONFIG:-}" ] && [ -f "$RIG_CONFIG/shell/common.sh" ]; then
  # shellcheck disable=SC1091
  . "$RIG_CONFIG/shell/common.sh"
elif [ -n "${RIG_ROOT:-}" ] && [ -f "$RIG_ROOT/templates/shell/common/profile.sh" ]; then
  # shellcheck disable=SC1091
  . "$RIG_ROOT/templates/shell/common/profile.sh"
fi

autoload -Uz colors && colors
setopt AUTO_CD
setopt HIST_IGNORE_DUPS
setopt SHARE_HISTORY
HISTSIZE=5000
SAVEHIST=5000
HISTFILE="${HISTFILE:-$HOME/.zsh_history}"

# Completion (no framework required)
autoload -Uz compinit
compinit -C 2>/dev/null || compinit

PROMPT='%F{green}%n@%m%f %F{blue}%~%f %# '
RPROMPT='%F{240}%T%f'
