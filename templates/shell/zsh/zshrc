# SSH を切ってローカルに戻った直後にバナーと同じ色の罫線を表示
_dots_precmd_after_ssh() {
  if [[ -n "${_dots_just_ran_ssh:-}" && -z "$SSH_CONNECTION" ]]; then
    echo "\033[36m$(_dots_hrule "${COLUMNS:-${DOTS_BANNER_WIDTH:-40}}")\033[0m"
    unset _dots_just_ran_ssh
  fi
}
add-zsh-hook precmd _dots_precmd_after_ssh

# コマンド開始時間を記録
preexec() {
  SECONDS=0
  [[ "$1" == ssh* && -z "$SSH_CONNECTION" ]] && _dots_just_ran_ssh=1
}

