# rig checkout helpers (optional local git workflow)
__rigpush() {
  local repo="${RIG_ROOT:-}"
  [[ -n "$repo" ]] || { echo "RIG_ROOT not set"; return 1; }
  local prev="$PWD"
  cd "$repo" || return 1
  git add -A
  if git diff --cached --quiet; then
    echo "No changes to commit."
    cd "$prev" || true
    return 0
  fi
  git commit -m "Update"
  git push
  local ret=$?
  cd "$prev" || true
  return $ret
}

__rigpull() {
  local repo="${RIG_ROOT:-}"
  [[ -n "$repo" ]] || { echo "RIG_ROOT not set"; return 1; }
  local prev="$PWD"
  cd "$repo" || return 1
  git fetch origin main && git merge --ff-only origin/main
  local ret=$?
  cd "$prev" || true
  return $ret
}

__rigstat() {
  local repo="${RIG_ROOT:-}"
  [[ -n "$repo" ]] || { echo "RIG_ROOT not set"; return 1; }
  local prev="$PWD"
  cd "$repo" || return 1
  git status
  local ret=$?
  cd "$prev" || true
  return $ret
}

alias rigpush='__rigpush'
alias rigpull='__rigpull'
alias rigstat='__rigstat'
alias dotpush='rigpush'
alias dotpull='rigpull'
alias dotstat='rigstat'


