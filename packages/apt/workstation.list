# Workstation extras on linux (plus apt/common.list via role).
#
# Julia  → install juliaup from https://julialang.org/install/ (not always in apt)
# Python → python3 + venv + uv
# R      → r-base
# C/C++  → build-essential + cmake/ninja/clang + libomp (OpenMP)
# Rust   → rustup from https://rustup.rs/ (prefer over apt rustc)
# Lean   → elan upstream installer (do NOT use apt elan; bookworm≈1.4.2, trixie≈3.1.1):
#          curl -fsSL https://elan.lean-lang.org/elan-init.sh | sh -s -- -y --default-toolchain stable --no-modify-path
#          then: elan default stable
# Java   → openjdk-17-jdk + maven

gh
curl
build-essential
cmake
ninja-build
pkg-config
clang
libomp-dev
lldb
python3
python3-pip
python3-venv
uv
r-base
openjdk-17-jdk
maven
# elan / rustup / juliaup: use upstream installers when not packaged
# (elan: https://elan.lean-lang.org/elan-init.sh  rustup: https://rustup.rs/  juliaup: https://julialang.org/install/)
