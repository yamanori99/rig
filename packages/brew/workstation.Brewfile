# Workstation extras (GUI / full dev)
#
# Languages aimed to be usable out of the box after `rig apply`:
#   Julia  → juliaup  (then: juliaup update)
#   Python → uv + pyenv (+ build deps below; pyenv install X / uv sync)
#   R      → r
#   C/C++  → cmake, ninja, llvm, gcc, libomp, pkgconf
#            (also need Xcode CLT: xcode-select --install)
#   Rust   → rustup   (then: rustup default stable)
#   Java   → openjdk@17 + maven

brew "gh"
brew "colima"
brew "docker"
brew "docker-compose"
brew "ffmpeg"
brew "ollama"
brew "terminal-notifier"
brew "telnet"

# --- Languages / toolchains ---
brew "juliaup"
brew "uv"
brew "pyenv"
brew "openssl@3"
brew "readline"
brew "sqlite"
brew "xz"
brew "zlib"
brew "r"
brew "openjdk@17"
brew "maven"
brew "rustup"
brew "cmake"
brew "ninja"
brew "pkgconf"
brew "llvm"
brew "libomp"
brew "gcc"

cask "cursor"
cask "betterdisplay"
cask "stats"
